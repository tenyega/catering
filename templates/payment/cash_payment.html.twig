{% extends 'base.html.twig' %}

{% block body %}
	<div class="flex items-start justify-between p-6">
		<div class="grid w-full grid-cols-4 gap-4 p-4">
			{% set currencies = {
        '200': 'img/200.jpg',
        '100': 'img/100.jpg',
        '50': 'img/50.jpg',
        '20': 'img/20.jpg',
        '10': 'img/10.jpg',
        '5': 'img/5.jpg',
        '1': 'img/1.jpg',
        '50c': 'img/50c.jpg',
        '20c': 'img/20c.jpg',
        '10c': 'img/10c.jpg',
        '5c': 'img/5c.jpg',
        '2c': 'img/2c.jpg',
        '1c': 'img/1c.jpg'
    } %}

			{% for value, image in currencies %}
				<button class="flex items-center justify-center transition duration-200 bg-gray-100 rounded-lg shadow-md currency-btn hover:bg-gray-200 focus:outline-none" data-value="{{ value }}">
					<img src="{{ asset(image) }}" alt="{{ value }} currency" class="object-contain w-24 h-24">
				</button>
			{% endfor %}
		</div>


		<!-- Right Side: Total Display -->
		<div class="flex flex-col items-center justify-center w-1/2 p-6 bg-gray-100 rounded-lg shadow-lg">
			<h2 class="mb-4 text-2xl font-bold">Total</h2>
			<p id="total_display" class="text-4xl font-extrabold text-blue-600">${{total}}</p>
			<span id="payment_detail"></span>
			<a href='{{ path('cash_close', {'total': total})}}' id="card_payment_btn" class="px-4 py-2 text-white bg-blue-500 rounded hover:bg-blue-600">
				Pay
			</a>
		</div>

	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function () { // Get initial total value, remove the '$' and convert to number
let total = parseFloat(document.getElementById('total_display').innerText.replace('$', ''));
const totalDisplay = document.getElementById('total_display');
const paymentDetail = document.getElementById('payment_detail');

document.querySelectorAll('.currency-btn').forEach(button => {
button.addEventListener('click', function () { // Get the value and handle different formats (e.g., '50c', '200')
let value = this.getAttribute('data-value');
let amount;

if (value.endsWith('c')) { // Handle cents: convert '50c' to 0.50
amount = parseFloat(value.replace('c', '')) / 100;
} else { // Handle dollars
amount = parseFloat(value);
}

// Update total
if (total >= amount) {
total -= amount;
totalDisplay.textContent = `$${
total.toFixed(2)
}`;
// Display the payment detail
paymentDetail.innerHTML += `<div>-$${
amount.toFixed(2)
}</div>`;
} else { // Calculate change to return
let change = amount - total;
total = 0; // Set remaining total to 0
totalDisplay.textContent = `$${
total.toFixed(2)
}`;

// Display both the payment and the change
paymentDetail.innerHTML += `
                    <div>-$${
amount.toFixed(2)
} (Paid)</div>
                    <div class="text-red-500">$${
change.toFixed(2)
} (Balance)</div>
                `;
}
});
});
});
	</script>

{% endblock %}
