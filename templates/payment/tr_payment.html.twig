{% extends 'base.html.twig' %}

{% block body %}
<div class="container mx-auto p-6">

    <!-- Title Section -->
    <h1 class="text-3xl font-bold text-center mb-6">Restaurant Ticket Calculation</h1>

    <!-- Form Section -->
    <form method="POST" class="max-w-lg mx-auto bg-white p-6 rounded-lg shadow-lg">

        <div class="mb-4">
            <label for="ticket_value" class="block text-lg font-medium text-gray-700">Ticket Restaurant Value (in currency):</label>
            <input type="text" id="ticket_value" name="ticket_value" step="0.01" required class="mt-2 block w-full p-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <div class="mb-4">
            <label for="num_tickets" class="block text-lg font-medium text-gray-700">Number of Tickets:</label>
            <input type="number" id="num_tickets" name="num_tickets" min="1" required class="mt-2 block w-full p-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

       

    </form>

    <!-- Subtotal and Final Total Section -->
    {% if ticket_value is defined and num_tickets is defined %}
        {% set subtotal = ticket_value * num_tickets %}
        <div class="mt-6 text-center">
            <p class="text-xl font-semibold">Subtotal: <span class="font-bold text-blue-600">{{ subtotal | number_format(2) }}</span></p>
        </div>

        <div class="mt-4 text-center">
            <p class="text-xl font-semibold">Final Total (after applying ticket restaurant): <span class="font-bold text-blue-600">{{ total - subtotal | number_format(2) }}</span></p>
        </div>
    {% endif %}

    <!-- Total Display and Payment Section -->
    <div class="mt-12 flex flex-col items-center justify-center bg-gray-100 p-6 rounded-lg shadow-xl">
        <h2 class="text-2xl font-bold mb-4">Total</h2>
        <p id="total_display" class="text-4xl font-extrabold text-blue-600 mb-4">${{ total | number_format(2) }}</p>
        <span id="payment_detail" class="text-lg text-gray-600 mb-6"></span>
        
        <a href="{{ path('tr_close', {'total': total}) }}" 
           id="card_payment_btn"
           class="bg-blue-500 text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition duration-200">
            Pay
        </a>
          <span id="payment_detail"></span>
    </div>

</div>
<script>
// Get the ticket value and number of tickets from the input fields
const ticket_value = document.getElementById('ticket_value');
const num_tickets = document.getElementById('num_tickets');
const payment_detail = document.getElementById('payment_detail');
const total_display = document.getElementById('total_display');

// Get the total value from Twig (this should be passed to the script)
const total = parseFloat("{{ total | number_format(2, '.', '') }}");

// Function to update the payment details with the current values
function updatePaymentDetail() {
    const ticketValue = parseFloat(ticket_value.value);
    const numTickets = parseInt(num_tickets.value);

    // Clear previous child elements inside payment_detail
    while (payment_detail.firstChild) {
        payment_detail.removeChild(payment_detail.firstChild);
    }

    if (!isNaN(ticketValue) && !isNaN(numTickets)) {
        const subtotal = ticketValue * numTickets;
        const remainingAmount = total - subtotal;

        // Display ticket value, number of tickets, and subtotal
        payment_detail.innerText = `${ticketValue.toFixed(2)} X ${numTickets} = ${subtotal.toFixed(2)}`;

        // Create a new element to show how much change needs to be returned or the insufficient funds message
        const resultMessage = document.createElement('p');
        
        // Check if the remaining amount is negative
      
            // Otherwise, show the remaining amount (change)
            resultMessage.innerText = `Your balance is  ${remainingAmount.toFixed(2)}. Sorry we dont return on the ticket restaurent!!!`;
            resultMessage.style.color = 'green';  // Optional styling for the change amount
       

        // Append the result message as a child to the payment_detail element
        payment_detail.appendChild(resultMessage);
    }
}

// Event listeners to trigger the update when either input changes
ticket_value.addEventListener('input', updatePaymentDetail);
num_tickets.addEventListener('input', updatePaymentDetail);

// Initial update to set the correct message based on initial values
updatePaymentDetail();
</script>




{% endblock %}
