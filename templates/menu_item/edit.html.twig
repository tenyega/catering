{% extends 'base.html.twig' %}

{% block body %}
	<div class="container px-4 py-8 mx-auto">
		<h1 class="mb-6 text-3xl font-bold">Edit Menu Item</h1>

		<div class="p-6 bg-white rounded-lg shadow-md">
			{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

			<!-- Name Field -->
			<div>
				{{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.name, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.name, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<!-- Description Field -->
			<div>
				{{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.description, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.description, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<!-- Price Field -->
			<div>
				{{ form_label(form.price, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.price, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.price, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<!-- Category Field -->
			<div>
				{{ form_label(form.category, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.category, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.category, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<!-- IsAvailable Checkbox -->
			<div class="flex items-center">
				{{ form_widget(form.isAvailable, {'attr': {'class': 'h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500'}}) }}
				{{ form_label(form.isAvailable, null, {'label_attr': {'class': 'ml-2 block text-sm font-medium text-gray-700'}}) }}
				{{ form_errors(form.isAvailable, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<!-- Image Upload Field -->
			<div>
				{{ form_label(form.img, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.img, {'attr': {'class': 'mt-1 block w-full text-sm text-gray-700 border border-gray-300 rounded-md cursor-pointer focus:outline-none focus:border-indigo-500 focus:ring-indigo-500'}}) }}
				{{ form_errors(form.img, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<!-- Save Button -->
			<div class="flex justify-end">
				<button class="px-4 py-2 text-white bg-indigo-500 rounded hover:bg-indigo-600">
					Save Changes
				</button>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
