{% extends 'base.html.twig' %}

{% block title %}Menu Item List Page
{% endblock %}

{% block body %}
	{% if is_granted('ROLE_ADMIN') %}
		<a href="{{ path('menu_item_add') }}" class="px-3 py-1 text-white bg-green-500 rounded hover:bg-green-600">
			Add new Menu Item
		</a>
	{% endif %}
	<div class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
		{% for menuItem in menuItems %}

			<!-- Example Menu Item Card -->
			<div class="overflow-hidden bg-white rounded-lg shadow-md">

				<img class="object-cover w-full h-48" src="{{ file_exists('img/' ~ menuItem.name ~ '.jpg') ? asset('img/' ~ menuItem.name ~ '.jpg') : asset('img/default.jpg') }}" alt="Menu Image">
				<div class="p-4">
					<h3 class="mb-2 text-lg font-bold">{{menuItem.name}}</h3>
					<p class="mb-2 text-sm text-gray-700">
						{{menuItem.description}}
					</p>
					<p class="text-sm font-semibold text-gray-900">Price: ${{menuItem.price}}</p>
					<p class="text-sm text-gray-600">Category:
						{{menuItem.category}}</p>
				</div>
				<div class="flex justify-between px-4 py-2 bg-gray-100">
					<a href="{{ path('menu_item_edit', { 'id': menuItem.id }) }}" class="px-3 py-1 text-white bg-yellow-500 rounded hover:bg-yellow-600">
						Edit
					</a>
					{% if is_granted('ROLE_ADMIN') %}
						<a href="{{ path('menu_item_delete', { 'id': menuItem.id }) }}" class="px-3 py-1 text-white bg-red-500 rounded hover:bg-red-600">
							Delete
						</a>
					{% endif %}


				</div>
			</div>
		{% endfor %}
	</div>
{% endblock %}
