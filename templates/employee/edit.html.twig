{% extends 'base.html.twig' %}

{% block body %}

	<div class="container px-4 py-8 mx-auto">
		<h1 class="mb-6 text-3xl font-bold">Edit Employee</h1>

		<div class="p-6 bg-white rounded-lg shadow-md">
			{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}


			<div>
				{{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.email, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.email, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<div>
				{{ form_label(form.password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.password, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.password, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>


			<!-- Save Button -->
			<div class="flex justify-end">
				<button class="px-4 py-2 text-white bg-indigo-500 rounded hover:bg-indigo-600">
					Save Changes
				</button>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
