{% extends 'base.html.twig' %}

{% block title %}
	Admin Reports
{% endblock %}

{% block body %}
	<div class="min-h-screen bg-gray-100">
		<div
			class="container py-10 mx-auto">
			<!-- Page Title -->
			<h1 class="mb-10 text-4xl font-bold text-center text-gray-800">
				Admin Reports
			</h1>

			<!-- Sales Overview Card -->
			<div
				class="p-8 m-20 bg-white rounded-lg shadow-lg">
				<!-- Key Metrics (Horizontal Layout) -->
				<div class="flex items-center justify-between mb-6">
					<div class="text-center">
						<h3 class="text-lg font-medium text-gray-700">
							<strong>Total Revenue &euro;</strong>
						</h3>
						<p class="text-xl text-gray-900">{{ salesReport.totalRevenue }}</p>
					</div>
					<div class="text-center">
						<h3 class="text-lg font-medium text-gray-700">
							<strong>Total Orders</strong>
						</h3>
						<p class="text-xl text-gray-900">{{ salesReport.totalOrders }}</p>
					</div>
					<div class="text-center">
						<h3 class="text-lg font-medium text-gray-700">
							<strong>Avg Order Value &euro;</strong>
						</h3>
						<p class="text-xl text-gray-900">{{ salesReport.avgOrderValue | number_format(5) }}</p>
					</div>
				</div>

				<!-- Chart -->
				<div class="mb-6 chart-container">
					<canvas id="salesChart" class="w-full mx-auto h-72"></canvas>
				</div>
			</div>
		</div>
	</div>

	{% block javascripts %}
		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
		<script>
			document.addEventListener('DOMContentLoaded', initializeChart);

function initializeChart() {
const ctx = document.getElementById('salesChart');
if (ctx) {
new Chart(ctx.getContext('2d'), {
type: 'bar',
data: {
labels: [
'Total Revenue', 'Total Orders', 'Avg Order Value'
],
datasets: [
{
label: 'Sales Overview',
data: [
{{ salesReport.totalRevenue }}, {{ salesReport.totalOrders }}, {{ salesReport.avgOrderValue }}
],
backgroundColor: [
'rgba(75, 192, 192, 0.2)', 'rgba(54, 162, 235, 0.2)', 'rgba(255, 206, 86, 0.2)'
],
borderColor: [
'rgba(75, 192, 192, 1)', 'rgba(54, 162, 235, 1)', 'rgba(255, 206, 86, 1)'
],
borderWidth: 1
}
]
},
options: {
responsive: true,
scales: {
y: {
beginAtZero: true
}
}
}
});
}
}
		</script>
	{% endblock %}
{% endblock %}
