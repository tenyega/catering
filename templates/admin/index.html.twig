{% extends 'base.html.twig' %}

{% block title %}Admin Reports{% endblock %}

{% block body %}
<div class="bg-gray-100 min-h-screen">
    <div class="container mx-auto py-10">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Admin Reports</h1>

        <div class="bg-white shadow-lg rounded-lg p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">Sales Overview</h2>
           <div class="chart-container mb-6">
    <canvas id="salesChart" class="w-3/4 h-64 mx-auto"></canvas>
</div>

            <ul class="space-y-3">
                <li class="bg-gray-50 p-4 border border-gray-200 rounded-md shadow-sm">
                    <span class="font-medium">Total Revenue:</span> <b>{{ salesReport.totalRevenue }}</b>
                </li>
                <li class="bg-gray-50 p-4 border border-gray-200 rounded-md shadow-sm">
                    <span class="font-medium">Total Orders:</span><b> {{ salesReport.totalOrders }}</b>
                </li>
                <li class="bg-gray-50 p-4 border border-gray-200 rounded-md shadow-sm">
                    <span class="font-medium">Average Order Value:</span><b> {{ salesReport.avgOrderValue }}</b>
                </li>
            </ul>
        </div>
    </div>
</div>
{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', initializeChart); // Runs on the initial load

// If using Turbolinks or another dynamic page loader, listen for page:load events
document.addEventListener('turbolinks:load', initializeChart); // Runs on Turbolinks page change

const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
        if (mutation.type === 'childList') {
            initializeChart(); // Reinitialize when DOM changes
        }
    });
});

observer.observe(document.body, {
    childList: true,
    subtree: true,
});

function initializeChart() {
    const ctx = document.getElementById('salesChart');
    if (ctx) { // Only initialize if the chart exists
        new Chart(ctx.getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['Total Revenue', 'Total Orders', 'Avg Order Value'],
                datasets: [{
                    label: 'Sales Overview',
                    data: [
                        {{ salesReport.totalRevenue }}, 
                        {{ salesReport.totalOrders }}, 
                        {{ salesReport.avgOrderValue }}
                    ],
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.2)',
                        'rgba(54, 162, 235, 0.2)',
                        'rgba(255, 206, 86, 0.2)'
                    ],
                    borderColor: [
                        'rgba(75, 192, 192, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(255, 206, 86, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }
}

</script>
{% endblock %}
{% endblock %}
