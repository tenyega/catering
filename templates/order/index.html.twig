{% extends 'base.html.twig' %}

{% block title %}Order List Page
{% endblock %}

{% block body %}


	{% include 'orderFilter.html.twig' with {'route': route} %}

{% if orders == null  %} <h1 class="mb-6 text-3xl font-bold text-gray-800 text-center mt-20 mb-20">No order to show </h1>
{% else %}
	

	<h1>Orders:
		{{ orders | length }}</h1>
	<div
		class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
		<!-- Loop through orders -->


		{% for order in orders %}
			<div class="p-6 mb-4 bg-white rounded-lg shadow">
				<div
					class="grid grid-cols-2 gap-4">
					<!-- Order ID and Date -->
					<div>
						<h2 class="text-lg font-semibold text-gray-700">Order ID:
							{{ order.id }}</h2>
						<p class="text-sm text-gray-500">Date:
							{{ order.orderDate|date('Y-m-d H:i') }}</p>
					</div>

					<!-- Payment and Order Status -->
					<div>
						<p class="text-sm font-medium text-gray-700">
							Payment Status:
							<span class="{% if order.paymentStatus == 'PAID' %}text-green-600{% else %}text-red-600{% endif %}">
								{{ order.paymentStatus }}
							</span>
						</p>
						<p class="text-sm font-medium text-gray-700">
							Order Status:
							<span class="text-blue-600">{{ order.orderStatus }}</span>
						</p>
					</div>
				</div>

				<!-- user -->
				<div class="mt-4">
					<p class="text-sm text-gray-700">
						<span class="font-semibold">User:</span>
						{{ order.getUser().getFirstName()}}
					</p>

				</div>


				<!-- Order Items -->
				<div class="mt-6">
					<h3 class="mb-2 text-lg font-semibold text-gray-700">Order Items</h3>
					<ul class="pl-6 space-y-1 text-sm text-gray-700 list-disc">
						{% for orderItem in order.getOrderItems() %}

							<li>
								<span class="font-medium">{{ orderItem.getMenuItem().getName()}}</span>
								&nbsp; X
								{{ orderItem.getQuantity() }}
								&nbsp;
								{{ orderItem.getMenuItem().getPrice()}}
								&nbsp; subtotal : ${{ orderItem.getItemPrice() }}
							</li>

						{% endfor %}
					</ul>
				</div>
			<div class="mt-4">
    <p class="text-sm text-gray-700">
        <span class="font-semibold">Special Request:</span>
    </p>
    <div class="mt-2 bg-gray-50 border border-gray-200 p-4 rounded-lg">
        <p class="text-sm text-gray-700 italic">
            {{ order.getSpecialRequest() }}
        </p>
    </div>
</div>
				<!-- Total Amount -->
				<div class="mt-4">
					<p class="text-xl font-bold text-gray-800">Total: ${{ order.totalAmount }}</p>
				</div>
			</div>


		{% endfor %}
	</div>
{% endif %}
{% endblock %}
