{% extends 'base.html.twig' %}

{% block title %}Order List Page
{% endblock %}

{% block body %}
	{% include 'orderFilter.html.twig' with {'route': route} %}

{% if orders == null  %} <h1 class="mb-6 text-3xl font-bold text-gray-800 text-center mt-20 mb-20">No order to show </h1>
{% else %}
	

	<h1>Orders:
		{{ orders | length }}</h1>
	<div
		class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
		<!-- Loop through orders -->
	<div class="container p-6 mx-auto ">
		<h1 class="mb-6 text-2xl font-bold">Total Orders:
			{{ orders | length }}</h1>
		<div
			class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">


			<!-- Loop through orders -->
			{% for order in orders %}
				<div
					class="p-6 bg-white border border-gray-200 rounded-lg shadow-lg">
					<!-- Order Details -->
					<div
						class="grid grid-cols-2 gap-4">
						<!-- Order ID and Date -->
						<div>
							<h2 class="text-lg font-semibold text-gray-700">Order ID:
								{{ order.id }}</h2>
							<p class="text-sm text-gray-500">Date:
								{{ order.orderDate|date('Y-m-d H:i') }}</p>
						</div>

						<!-- Payment and Order Status -->
						<div>
							<p class="text-sm font-medium text-gray-700">
								Payment Status:
								<span class="{% if order.paymentStatus == 'PAID' %}text-green-600{% else %}text-red-600{% endif %}">
									{{ order.paymentStatus }}
								</span>
							</p>
							<p class="text-sm font-medium text-gray-700">
								Order Status:
								{# <span id='status_span' class="font-semibold text-blue-600">{{ order.orderStatus }}</span> #}
								<span id="status_span-{{ order.id }}" class="font-semibold text-blue-600">{{ order.orderStatus }}</span>

							</p>
						</div>
					</div>

					<!-- User -->
					<div class="mt-4">
						<p class="text-sm text-gray-700">
							<span class="font-semibold">User:</span>
							{{ order.getUser().getFirstName() }}
						</p>
					</div>

				<!-- Order Items -->
				<div class="mt-6">
					<h3 class="mb-2 text-lg font-semibold text-gray-700">Order Items</h3>
					<ul class="pl-6 space-y-1 text-sm text-gray-700 list-disc">
						{% for orderItem in order.getOrderItems() %}

							<li>
								<span class="font-medium">{{ orderItem.getMenuItem().getName()}}</span>
								&nbsp; X
								{{ orderItem.getQuantity() }}
								&nbsp;
								{{ orderItem.getMenuItem().getPrice()}}
								&nbsp; subtotal : ${{ orderItem.getItemPrice() }}
							</li>

						{% endfor %}
					</ul>
				</div>
			<div class="mt-4">
    <p class="text-sm text-gray-700">
        <span class="font-semibold">Special Request:</span>
    </p>
    <div class="mt-2 bg-gray-50 border border-gray-200 p-4 rounded-lg">
        <p class="text-sm text-gray-700 italic">
            {{ order.getSpecialRequest() }}
        </p>
    </div>
</div>
				<!-- Total Amount -->
				<div class="mt-4">
					<p class="text-xl font-bold text-gray-800">Total: ${{ order.totalAmount }}</p>
				</div>
			</div>


		{% endfor %}
					<!-- Order Items -->
					<div class="mt-6">
						<h3 class="mb-2 text-lg font-semibold text-gray-700">Order Items</h3>
						<ul class="pl-6 space-y-1 text-sm text-gray-700 list-disc">
							{% for orderItem in order.getOrderItems() %}
								<li>
									<span class="font-medium">{{ orderItem.getMenuItem().getName() }}</span>
									×
									{{ orderItem.getQuantity() }}
									- ${{ orderItem.getMenuItem().getPrice() }}
									<span class="font-semibold">Subtotal:</span>
									${{ orderItem.getItemPrice() }}
								</li>
							{% endfor %}
						</ul>
					</div>

					<!-- Total Amount -->
					<div class="mt-4">
						<p class="text-xl font-bold text-gray-800">Total: ${{ order.totalAmount }}</p>
					</div>

					<!-- Update Order Status -->
					<div class="mt-6">
						<form action="{{ path('order_status', {id: order.id}) }}" method="post">
							<input type="hidden" name="_token" value="{{ csrf_token('order_status' ~ order.id) }}">

							<label for="order-status-{{ order.id }}" class="block mb-2 text-sm font-medium text-gray-700">
								Change Order Status:
							</label>
							<select id="order-status-{{ order.id }}" name="orderStatus" id='orderStatus' class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
								{% for status in ['DELIVERED', 'RECEIVED', 'CANCELLED', 'PROCESSING', 'DELIVERY'] %}
									<option value="{{ status }}" {% if order.orderStatus == status %} selected {% endif %}>
										{{ status }}
									</option>
								{% endfor %}
							</select>

							<button type="submit" class="w-full px-4 py-2 mt-4 text-white transition bg-blue-500 rounded hover:bg-blue-600">
								Update Status
							</button>
						</form>
					</div>
				</div>
			{% endfor %}

		</div>
	</div>
	<script>
		// Attach event listeners to all order status dropdowns
document.querySelectorAll('select[id^="order-status-"]').forEach((selectElement) => {
selectElement.addEventListener('change', function (e) { // Get the corresponding span element for this order
const orderId = this.id.split('-').pop(); // Extract order ID from the select element's ID
const statusSpan = document.querySelector (`#status_span-${orderId}`);

// Update the status span text with the selected value
if (statusSpan) {
statusSpan.innerHTML = this.value;
}
});
});
	</script>

{% endblock %}
