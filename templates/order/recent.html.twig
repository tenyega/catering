{% extends 'base.html.twig' %}

{% block title %}Track Your Order
{% endblock %}

{% block body %}
	{% if order == null %}
		<h1 class="mt-20 mb-6 text-3xl font-bold text-center text-gray-800">No recent order to show</h1>
	{% else %}
		<div class="container p-6 mx-auto">
			<h1 class="mb-6 text-2xl font-bold text-gray-800">Track Your Order</h1>

			<div
				class="flex flex-col gap-8 lg:flex-row">
				<!-- Order Details Section -->
				<div class="p-6 bg-white rounded-lg shadow-lg lg:w-1/2">
					<h3 class="mb-4 text-lg font-semibold text-gray-800">Order Details</h3>
					<div class="space-y-4 text-sm text-gray-700">
						<p>
							<strong>Date:</strong>
							{{ order.orderDate|date('Y-m-d H:i') }}</p>

						<p>
							<strong>Payment Status:</strong>
							<span class="{% if order.paymentStatus == 'PAID' %}text-green-600{% else %}text-red-600{% endif %}">{{ order.paymentStatus }}</span>
						</p>
						<p>
							<strong>User:</strong>
							{{ order.getUser().getFirstName() }}</p>
						<p>
							<strong>Special Request:</strong>
						</p>
						<div class="p-4 border border-gray-300 rounded-lg bg-gradient-to-r from-gray-100 via-gray-200 to-gray-300">
							<span class="italic text-gray-700">{{ order.getSpecialRequest() }}</span>
						</div>
					</div>
					<h3 class="mt-6 text-lg font-semibold text-gray-800">Order Items</h3>
					<ul class="mt-4 space-y-2">
						{% for orderItem in order.getOrderItems() %}
							<li class="flex justify-between">
								<span>{{ orderItem.getMenuItem().getName()|replace({'_': ' '})|upper }}
									&nbsp; X &nbsp;
									{{ orderItem.getQuantity() }}</span>
								<span>&euro;{{ orderItem.getItemPrice() }}</span>
							</li>
						{% endfor %}
					</ul>
					<p class="mt-6 text-xl font-bold text-gray-800">Total: &euro;{{ order.totalAmount }}</p>
				</div>

				<!-- Order Tracking Section -->
				<div class="p-6 rounded-lg shadow-lg lg:w-1/2 bg-[#22427c] text-white">
					<h3 class="mb-6 text-lg font-semibold">Order Tracking</h3>
					<ol
						class="relative space-y-8 border-l border-gray-500">
						<!-- Status Steps -->
						{% for status, label in {
            1: 'Order Received',
            2: 'Processing',
            3: 'Out for Delivery',
            4: 'Delivered',
            5: 'Cancelled'
        } %}
							<li class="ml-6">
								<span class="absolute w-8 h-8 flex items-center justify-center rounded-full -left-4
																																																																						                    {% if statusID >= status %}
																																																																						                        bg-green-500 text-white
																																																																						                    {% else %}
																																																																						                        bg-gray-400 text-gray-200
																																																																						                    {% endif %}">
									{% if statusID >= status %}
										<!-- Checkmark for completed and current steps -->
										<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
										</svg>
									{% else %}
										<!-- Circle for pending steps -->
										<div class="w-3 h-3 bg-white rounded-full"></div>
									{% endif %}
								</span>
								<h4 class="text-base font-semibold
																																																															                    {% if statusID == status %}
																																																															                        text-green-300
																																																															                    {% else %}
																																																															                        text-gray-200
																																																															                    {% endif %}">{{ label }}</h4>
								<p class="text-sm text-gray-300">
									{% if status == 1 %}
										Your order has been received.
									{% endif %}
									{% if status == 2 %}
										Your order is being processed.
									{% endif %}
									{% if status == 3 %}
										Your order is out for delivery.
									{% endif %}
									{% if status == 4 %}
										Your order has been delivered. Enjoy your meal!
									{% endif %}
									{% if status == 5 %}
										Your order has been cancelled.
									{% endif %}
								</p>
							</li>
						{% endfor %}
					</ol>
					<div class="mt-8">
						<a href="{{ path('order_cancel') }}" class="block w-full py-2 text-sm font-medium text-center text-white bg-gray-700 rounded-lg hover:bg-gray-800">
							Cancel the Order
						</a>
					</div>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}
