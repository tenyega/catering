{% extends 'base.html.twig' %}

{% block title %}Track Your Order
{% endblock %}

{% block body %}
{% if order== null %}
	<h1 class="mb-6 text-3xl font-bold text-gray-800 text-center mt-20 mb-20">No recent order to show
	</h1>
{% else %}
	<div class="container p-6 mx-auto ">
		<h1 class="mb-6 text-2xl font-bold text-gray-800">Track Your Order</h1>
		<div
			class="flex justify-center gap-4 mx-4 lg:mx-8">
			<!-- First Div -->
			<div
				class="w-full p-6 transition-shadow duration-300 ease-in-out transform bg-white rounded-lg shadow-lg lg:w-1/2 hover:shadow-2xl hover:-translate-y-2">
				<!-- Loop through orders -->
				<div class="p-6 transition-shadow duration-300 ease-in-out transform bg-white rounded-lg shadow-lg hover:shadow-2xl hover:-translate-y-2">
					<div
						class="grid grid-cols-2 gap-4">
						<!-- Order ID and Date -->
						<div>
							<p class="text-sm text-gray-500">Date:
								<span class="font-semibold text-gray-800">{{ order.orderDate|date('Y-m-d H:i') }}</span>
							</p>
						</div>
						<!-- Payment and Order Status -->
						<div>
							<p class="text-gray-700 font-xl medium text-">
								<span class="{% if order.paymentStatus == 'PAID' %}text-green-600{% else %}text-red-600{% endif %} font-semibold">
									{{ order.paymentStatus }}
								</span>
							</p>

						</div>
					</div>

					<!-- User Info -->
					<div class="mt-4">
						<p class="text-sm text-gray-700">
							<span class="font-semibold">User:</span>
							{{ order.getUser().getFirstName() }}
						</p>
					</div>

					<!-- Order Items -->
					<div class="mt-6">
						<h3 class="pb-2 text-lg font-semibold text-gray-700 border-b border-gray-300">Order Items</h3>
						<ul class="mt-4 space-y-2">
							{% for orderItem in order.getOrderItems() %}
								<li class="flex items-center justify-between">
									<div class="flex-1 min-w-0">
										<span class="block font-medium truncate">{{ orderItem.getMenuItem().getName() }}
											x{{ orderItem.getQuantity() }}</span>
									</div>
									<div class="w-24 text-sm text-center text-gray-700">
										<span>${{ orderItem.getMenuItem().getPrice() }}</span>
									</div>
									<div class="w-32 text-sm text-right text-gray-500">
										<span class="text-gray-500">Subtotal:</span>
										<span class="font-semibold">${{ orderItem.getItemPrice() }}</span>
									</div>

								</li>

							{% endfor %}
						</ul>
					</div>
					<div class="mt-4">
						<p class="text-sm text-gray-700">
							<span class="font-semibold">Special Request:</span>
						</p>
						<div class="mt-2 bg-gray-50 border border-gray-200 p-4 rounded-lg">
							<p class="text-sm text-gray-700 italic">
								{{ order.getSpecialRequest() }}
							</p>
						</div>
					</div>
					<!-- Total Amount -->
					<div class="mt-6">
						<p class="text-xl font-bold text-gray-800">Total: ${{ order.totalAmount }}</p>
					</div>
				</div>
			</div>
			<!-- Second Div -->
			<div class="w-full p-6 space-y-6 bg-white bg-[#22427c] border border-gray-200 rounded-lg shadow-sm lg:w-1/2 dark:border-gray-700 dark:bg-gray-800">
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white">Order Tracking</h3>

				<ol
					class="relative border-gray-200 ms-3 border-s dark:border-gray-700">
					<!-- Order Received -->
					<li class="mb-10 ms-6">
						<span class="absolute flex items-center justify-center w-6 h-6 rounded-full -start-3 ring-8 ring-white
																																																																																        {% if order.orderStatus == 'Received' %}bg-green-500 text-white dark:bg-green-700 dark:ring-green-800{% else %}bg-gray-100 dark:bg-gray-700 dark:ring-gray-800{% endif %}">
							<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewbox="0 0 24 24">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 11.917L9.724 16.5 19 7.5"/>
							</svg>
						</span>
						<h4 class="mb-0.5 text-base font-semibold
																																																																						        {% if order.orderStatus == 'Received' %}text-green-500 dark:text-green-400{% else %}text-gray-900 dark:text-white{% endif %}">Order Received</h4>
						<p class="text-sm font-normal text-gray-500 dark:text-gray-400">Your order has been received.</p>
					</li>

					<!-- Payment Accepted -->
					<li class="mb-10 ms-6">
						<span class="absolute flex items-center justify-center w-6 h-6 rounded-full -start-3 ring-8 ring-white
																																																																																        {% if order.orderStatus == 'Processing' %}bg-green-500 text-white dark:bg-green-700 dark:ring-green-800{% else %}bg-gray-100 dark:bg-gray-700 dark:ring-gray-800{% endif %}">
							<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewbox="0 0 24 24">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16M4 8h16m-8 8h8"/>
							</svg>
						</span>
						<h4 class="mb-0.5 text-base font-semibold
																																																																						        {% if order.orderStatus == 'Processing' %}text-green-500 dark:text-green-400{% else %}text-gray-900 dark:text-white{% endif %}">Payment Accepted</h4>
						<p class="text-sm font-normal text-gray-500 dark:text-gray-400">Payment has been successfully processed.</p>
					</li>

					<!-- Processing Order -->
					<li class="mb-10 ms-6">
						<span class="absolute flex items-center justify-center w-6 h-6 rounded-full -start-3 ring-8 ring-white
																																																																																        {% if order.orderStatus == 'Processing' %}bg-green-500 text-white dark:bg-green-700 dark:ring-green-800{% else %}bg-gray-100 dark:bg-gray-700 dark:ring-gray-800{% endif %}">
							<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewbox="0 0 24 24">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18m-6 4H9m-4 4h10m2 0h4"/>
							</svg>
						</span>
						<h4 class="mb-0.5 text-base font-semibold
																																																																						        {% if order.orderStatus == 'Processing' %}text-green-500 dark:text-green-400{% else %}text-gray-900 dark:text-white{% endif %}">Processing</h4>
						<p class="text-sm font-normal text-gray-500 dark:text-gray-400">Your food is being prepared.</p>
					</li>

					<!-- Out for Delivery -->
					<li class="mb-10 ms-6">
						<span class="absolute flex items-center justify-center w-6 h-6 rounded-full -start-3 ring-8 ring-white
																																																																																        {% if order.orderStatus == 'Delivery' %}bg-green-500 text-white dark:bg-green-700 dark:ring-green-800{% else %}bg-gray-100 dark:bg-gray-700 dark:ring-gray-800{% endif %}">
							<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewbox="0 0 24 24">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M8 8l4 4-4 4"/>
							</svg>
						</span>
						<h4 class="mb-0.5 text-base font-semibold
																																																																						        {% if order.orderStatus == 'Delivery' %}text-green-500 dark:text-green-400{% else %}text-gray-900 dark:text-white{% endif %}">Out for Delivery</h4>
						<p class="text-sm font-normal text-gray-500 dark:text-gray-400">Your order is on the way.</p>
					</li>

					<!-- Delivered -->
					<li class="ms-6">
						<span class="absolute flex items-center justify-center w-6 h-6 rounded-full -start-3 ring-8 ring-white
																																																																																        {% if order.orderStatus == 'Delivered' %}bg-green-500 text-white dark:bg-green-700 dark:ring-green-800{% else %}bg-primary-100 dark:bg-primary-900 dark:ring-gray-800{% endif %}">
							<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewbox="0 0 24 24">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 11.917L9.724 16.5 19 7.5"/>
							</svg>
						</span>
						<h4 class="mb-0.5 text-base font-semibold
																																																																						        {% if order.orderStatus == 'Delivered' %}text-green-500 dark:text-green-400{% else %}text-gray-900 dark:text-white{% endif %}">Delivered</h4>
						<p class="text-sm font-normal text-gray-500 dark:text-gray-400">Your order has been delivered. Enjoy your meal!</p>
					</li>
				</ol>

				<div class="gap-4 sm:flex sm:items-center">
					<a href="{{ path('order_cancel')}}" class="w-full rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-primary-700 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700">Cancel the order</a>

				</div>
			</div>
		</div>
	</div>
</div>{% endif %}{% endblock %}
