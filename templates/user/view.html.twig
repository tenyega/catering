{% extends 'base.html.twig' %}

{% block title %}User List Page
{% endblock %}

{% block body %}

	<div
		class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">

		<!-- Example Menu Item Card -->
		<div class="overflow-hidden bg-white rounded-lg shadow-md">

			<div class="p-4">
				<h3 class="mb-2 text-lg font-bold">{{user.firstName}}
					{{user.lastName}}</h3>

				<p class="text-sm text-gray-600">
					Email:
					{{user.email}}</p>
			
				<p class="text-sm text-gray-600">
					Phone:
					{{user.phone}}</p>
				<p class="text-sm text-gray-600">
					Address:
					{{user.address}}</p>
			</div>

		</div>


	</div>


{% endblock %}
