{% extends 'base.html.twig' %}

{% block title %}User List Page
{% endblock %}

{% block body %}
	<a href="{{ path('user_add') }}" class="px-3 py-1 text-white bg-green-500 rounded hover:bg-green-600">
		Add new User
	</a>
	<div class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
		{% for user in users %}

			<!-- Example Menu Item Card -->
			<div class="overflow-hidden bg-white rounded-lg shadow-md">

				<div class="p-4">
					<h3 class="mb-2 text-lg font-bold">{{user.firstName}}
						{{user.lastName}}</h3>

					<p class="text-sm text-gray-600">
						Email:
						{{user.email}}</p>
					<p class="text-sm text-gray-600" type='password'>
						Password:
						<em>Not Displayed for Security Reasons</em>
					</p>
					<p class="text-sm text-gray-600">
						Phone:
						{{user.phone}}</p>
					<p class="text-sm text-gray-600">
						Address:
						{{user.address}}</p>
				</div>
				<div class="flex justify-between px-4 py-2 bg-gray-100">
					<a href="{{ path('user_edit', { 'id': user.id }) }}" class="px-3 py-1 text-white bg-yellow-500 rounded hover:bg-yellow-600">
						Edit
					</a>

					<a href="{{ path('user_delete', { 'id': user.id }) }}" class="px-3 py-1 text-white bg-red-500 rounded hover:bg-red-600">
						Delete
					</a>
				</div>
			</div>
		{% endfor %}

	</div>


{% endblock %}
