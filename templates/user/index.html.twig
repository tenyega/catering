{% extends 'base.html.twig' %}

{% block title %}User List Page
{% endblock %}

{% block body %}
	<div
		class="container px-6 py-10 mx-auto">
		<!-- Add New User Button -->
		<div class="flex justify-end mb-5 mr-20">
			<a href="{{ path('user_add') }}" class="inline-flex items-center px-5 py-3 text-white transition-colors duration-300 bg-green-600 rounded-lg shadow-lg hover:bg-green-700">
				<span class="mr-2 text-lg font-semibold">Add New User</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
				</svg>
			</a>
		</div>


		<!-- User Cards Grid -->
		<div class="grid grid-cols-1 gap-8 p-10 ml-10 mr-10 sm:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3">

			{% for user in pagination %}
				<!-- User Card -->
				<div class="transition-all duration-300 bg-white rounded-lg shadow-xl hover:shadow-2xl">
					<div
						class="p-6">
						<!-- User Name -->
						<h3 class="mb-4 text-xl font-bold text-gray-800">{{ user.firstName }}
							{{ user.lastName }}</h3>

						<!-- User Details -->
						<p class="mb-3 text-sm text-gray-600">
							<span class="font-medium text-gray-800">Email:</span>
							{{ user.email }}
						</p>
						<p class="mb-3 text-sm text-gray-600">
							<span class="font-medium text-gray-800">Phone:</span>
							{{ user.phone }}
						</p>
						<p class="text-sm text-gray-600">
							<span class="font-medium text-gray-800">Address:</span>
							{{ user.address }}
						</p>
					</div>

					<!-- Action Buttons -->
					<div class="flex items-center justify-between px-6 py-4 bg-gray-100 rounded-b-lg">
						<a href="{{ path('user_edit', { 'id': user.id }) }}" class="px-4 py-2 text-sm text-white transition-all duration-300 bg-yellow-500 rounded-lg hover:bg-yellow-600 focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2">
							Edit
						</a>
						<a href="{{ path('user_delete', { 'id': user.id }) }}" class="px-4 py-2 text-sm text-white transition-all duration-300 bg-red-500 rounded-lg hover:bg-red-600 focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
							Delete
						</a>
					</div>
				</div>
			{% endfor %}
		</div>

	</div>
	<div class="flex justify-center mt-4 mb-4 navigation">
		{{ knp_pagination_render(pagination) }}
	</div>
{% endblock %}
