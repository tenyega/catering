{% extends 'base.html.twig' %}

{% block body %}
	<div class="container max-w-4xl px-6 py-12 mx-auto">
		<h1 class="mb-8 text-4xl font-extrabold text-gray-800">{{title}}
			User</h1>

		{% if is_granted('ROLE_ADMIN') %}
			<div class="p-4 mb-6 border-l-4 border-blue-500 rounded-lg bg-blue-50">
				<h2 class="text-lg font-semibold text-blue-800">
					The password is set to the first name of the user entered!
				</h2>
			</div>
		{% endif %}

		<div class="p-8 bg-white rounded-lg shadow-lg">
			{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

			<div>
				{{ form_label(form.firstName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.firstName, {'attr': {'class': 'mt-2 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.firstName, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<div>
				{{ form_label(form.lastName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.lastName, {'attr': {'class': 'mt-2 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.lastName, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<div>
				{{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.email, {'attr': {'class': 'mt-2 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.email, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<div>
				{{ form_label(form.phone, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.phone, {'attr': {'class': 'mt-2 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}}) }}
				{{ form_errors(form.phone, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<div>
				{{ form_label(form.address, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.address, {'attr': {
                'class': 'mt-2 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm',
                'rows': 4
            }}) }}
				{{ form_errors(form.address, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
			</div>

			<div class="flex justify-end">
				<button type="submit" class="px-6 py-2 text-white bg-indigo-600 rounded-md shadow hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
					Save Changes
				</button>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
