{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}
	<script src="https://www.google.com/recaptcha/api.js?render=6Lce-MQqAAAAAMcAXguDdJ-GQ1cpR4aUE0gCu9ZT"></script>

	<div class="flex items-center justify-center min-h-screen px-4 py-12 bg-gray-100 sm:px-6 lg:px-8">
		<div class="w-full max-w-md p-6 space-y-8 bg-white rounded-lg shadow-lg">
			{% for flash_error in app.flashes('verify_email_error') %}
				<div class="p-3 mb-4 text-red-600 border border-red-500 rounded-lg alert alert-danger">
					{{ flash_error }}
				</div>
			{% endfor %}

			<h1 class="text-2xl font-bold text-center text-gray-800">Register</h1>

			{{ form_errors(registrationForm) }}

			{{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
			<div>
				{{ form_row(registrationForm.firstName, {
                        label: 'First name',
                        'attr': {'class': 'w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none'}
                    }) }}
			</div>
			<div>
				{{ form_row(registrationForm.lastName, {
                        label: 'Last name',
                        'attr': {'class': 'w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none'}
                    }) }}
			</div>
			<div>
				{{ form_row(registrationForm.phone, {
                        label: 'Phone Number',
                        'attr': {'class': 'w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none'}
                    }) }}
			</div>
			<div>
				{{ form_row(registrationForm.address, {
                        label: 'Address',
                        'attr': {'class': 'w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none'}
                    }) }}
			</div>
			<div>
				{{ form_row(registrationForm.email, {
                        'attr': {'class': 'w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none'}
                    }) }}
			</div>
			<div>
				{{ form_row(registrationForm.plainPassword, {
                        label: 'Password',
                        'attr': {'class': 'w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none'}
                    }) }}
			</div>

			<div>
				{{ form_row(registrationForm.agreeTerms, {
                        'attr': {'class': 'w-5 h-5 text-blue-500 m-4 focus:ring-blue-400'}
                    }) }}
			</div>

			<button type="submit" class="w-full px-4 py-2 text-white bg-blue-500 rounded-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400">
				Register
			</button>
			<div class="g-recaptcha" data-sitekey="6Lce-MQqAAAAAMcAXguDdJ-GQ1cpR4aUE0gCu9ZT"></div>
			{{ form_end(registrationForm) }}
		</div>
	</div>
{% endblock %}
